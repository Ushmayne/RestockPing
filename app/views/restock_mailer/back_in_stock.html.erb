<%# Email clients ignore <style> blocks and external CSS, so styles are inline. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; color: #1a1a1a;">
  <tr>
    <td align="center" style="padding: 24px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 480px;">
        <tr>
          <td style="font-size: 14px; color: #6b6b6b; padding-bottom: 16px;"><%= @event.shop_name %></td>
        </tr>
        <% if @event.image_url.present? %>
          <tr>
            <td style="padding-bottom: 16px;">
              <%= image_tag @event.image_url, alt: @event.product_title, width: 480,
                            style: "display: block; width: 100%; max-width: 480px; height: auto; border-radius: 8px;" %>
            </td>
          </tr>
        <% end %>
        <tr>
          <td style="font-size: 22px; font-weight: 600; line-height: 1.3; padding-bottom: 8px;">
            <%= @product_name %> is back in stock
          </td>
        </tr>
        <tr>
          <td style="font-size: 16px; line-height: 1.5; padding-bottom: 24px;">
            You asked us to let you know. Stock can run out again quickly.
          </td>
        </tr>
        <tr>
          <td>
            <%= link_to "Shop now", @event.product_url,
                        style: "display: inline-block; background: #1a1a1a; color: #ffffff; text-decoration: none; " \
                               "font-size: 16px; font-weight: 600; padding: 12px 24px; border-radius: 6px;" %>
          </td>
        </tr>
        <tr>
          <td style="font-size: 12px; color: #6b6b6b; line-height: 1.5; padding-top: 32px;">
            You're getting this one-time email because you signed up for a restock alert at <%= @event.shop_name %>.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
